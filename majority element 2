class Solution:
    def majorityElement(self, nums: List[int]) -> List[int]:
        d={}
        for i in nums:
            if(i in d):
                d[i]=d[i]+1
            else:
                d[i]=1
        ans=[]
        for key,value in d.items():
            if(value>len(nums)//3):
                ans.append(key)
        return ans
        
