# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def insertionSortList(self, head: Optional[ListNode]) -> Optional[ListNode]:
        # 
        dummy = ListNode()
        cur = head 
        while cur:
            prev = dummy 
            # Find where cur should be inserted in the sorted part
            while prev.next and prev.next.val < cur.val:
                prev = prev.next 
            # insert cur between prev and prev.next 
            nxt = cur.next 
            cur.next = prev.next 
            prev.next = cur 
            cur = nxt 
        return dummy.next 


    def insertionSortList(self, head: Optional[ListNode]) -> Optional[ListNode]:
        dummy = ListNode(0, head)
        # dummy.next = head
        last_sorted = head
        curr = head.next

        while curr:
            if curr.val >= last_sorted.val:
                # already in correct order
                last_sorted = curr
            else:
                # find the insertion point
                prev = dummy
                while prev.next.val < curr.val:
                    prev = prev.next
                # insert curr in the correct place
                last_sorted.next = curr.next
                curr.next = prev.next
                prev.next = curr
            curr = last_sorted.next
        return dummy.next

        
