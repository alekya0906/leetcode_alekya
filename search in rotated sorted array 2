class Solution:
    def search(self, nums: List[int], target: int) -> bool:
        n = len(nums)
        low, high = 0, n - 1

        while low <= high:
            mid = (low + high) // 2   # Calculate the middle index

            # If we find the target, return True immediately
            if nums[mid] == target:
                return True

            # When nums[low], nums[mid], and nums[high] are equal,
            # we cannot determine which half is sorted due to duplicates.
            # So, we shrink the search space from both ends.
            if nums[low] == nums[mid] == nums[high]:
                low += 1
                high -= 1
                continue

            # Case 1: Right half is sorted
            if nums[mid] <= nums[high]:
                # Check if target lies within the sorted right half
                if nums[mid] <= target <= nums[high]:
                    low = mid + 1
                else:
                    high = mid - 1

            # Case 2: Left half is sorted
            else:
                # Check if target lies within the sorted left half
                if nums[low] <= target <= nums[mid]:
                    high = mid - 1
                else:
                    low = mid + 1

        # If we exit the loop, target was not found
        return False
