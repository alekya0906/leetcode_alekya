class Solution:
    def connect(self, root: 'Optional[Node]') -> 'Optional[Node]':
        right_nodes_by_level: list[Node | None] = []
        
        def traverse(node: Node | None, depth: int):
            if not node:
                return

            if depth >= len(right_nodes_by_level):
                right_nodes_by_level.append(None)
            else:
                node.next = right_nodes_by_level[depth]
            right_nodes_by_level[depth] = node
            traverse(node.right, depth + 1)
            traverse(node.left, depth + 1)
        
        traverse(root, 0)
        return root
