# Definition for a binary tree node.
# class TreeNode:
#     def __init__(self, val=0, left=None, right=None):
#         self.val = val
#         self.left = left
#         self.right = right
class Solution:
    def kthSmallest(self, root: Optional[TreeNode], k: int) -> int:
        # recursive approach (not optimal)
        res = []
        def dfs(node):
            if not node: return 
            dfs(node.left)
            res.append(node.val)
            dfs(node.right)
        dfs(root)
        return res[k-1]

    def kthSmallest(self, root: Optional[TreeNode], k: int) -> int:
        # better
        ans = None 
        count = k 
        def helper(node):
            nonlocal ans, count
            if not node: return 
            helper(node.left)
            count -= 1
            if count == 0:
                ans = node.val 
                return 
            helper(node.right)
        helper(root)
        return ans
    
    def kthSmallest(self, root, k):
        # iterative approach (best solution)
        stack = []
        cur = root 
        while stack or cur:
            while cur:
                stack.append(cur)
                cur = cur.left
            node = stack.pop()
            k -= 1
            if k == 0:
                return node.val
            cur = node.right
